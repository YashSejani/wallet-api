# Copy this file to .env and replace secrets

# Database Credentials (Used by docker-compose.yml)
POSTGRES_USER=root
POSTGRES_PASSWORD=secret
POSTGRES_DB=bank_ledger

# Go Application Configuration (Used by util/config.go)
DB_SOURCE=postgresql://root:secret@localhost:5432/bank_ledger?sslmode=disable
SERVER_ADDRESS=0.0.0.0:8080
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_DURATION=15m